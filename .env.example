# CalorAI Logging Agent - configuration
# Copy this file to `.env` and fill in one provider's key.


# 1. Model profile - picks the provider for the text and vision models.
#    Options: sarvam | openai | anthropic | google | groq
MODEL_PROFILE=sarvam


# 2. API key - set the one that matches your profile.
SARVAM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=


# 3. Model names.
#    The 'sarvam' profile already knows its models (text=glm5.2, vision=gemma4),
#    so you can leave these blank.
#    Every other profile REQUIRES you to set both - hosted model names change
#    often, so there is no safe default. Check the provider's docs for the
#    current name. Examples (verify before using):
#      openai     text=gpt-4.1-mini            vision=gpt-4.1-mini
#      anthropic  text=claude-haiku-4-5        vision=claude-haiku-4-5
#      google     text=gemini-2.5-flash        vision=gemini-2.5-flash
#      groq       text=openai/gpt-oss-120b     vision=meta-llama/llama-4-scout-17b-16e-instruct
# TEXT_MODEL=
# VISION_MODEL=

# Override the provider per role if you want text and vision on different
# providers (defaults to MODEL_PROFILE for both).
# TEXT_PROVIDER=
# VISION_PROVIDER=


# 4. Background worker model - used for the reflection pass and nutrition
#    fallback. Defaults to the text model if left unset.
# WORKER_PROVIDER=
# WORKER_MODEL=


# 5. LangSmith tracing - optional, free at smith.langchain.com.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=calorai-logging-agent


# 6. Runtime - sensible defaults, override only if needed.
# CALORAI_DATA_DIR=./data
# CALORAI_DB_PATH=./data/calorai.db
AGENT_MAX_LOOPS=4
REQUEST_TIMEOUT_SECONDS=60
