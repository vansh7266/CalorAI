# CalorAI Logging Agent - configuration
# Copy this file to `.env` and fill it in.
#
# There are two ways to configure the models:
#   A. one provider for everything  -> set MODEL_PROFILE + its key   (simplest)
#   B. a different provider per role -> also set the *_PROVIDER / *_MODEL overrides
#
# =============================================================================
# A. SINGLE PROVIDER  (default)
# =============================================================================

# MODEL_PROFILE is the default provider for the text model, the vision model,
# and the background worker model.
#   Options: sarvam | openai | anthropic | google | groq
MODEL_PROFILE=sarvam

# Set the key for the provider you chose. Leave the rest blank/commented.
SARVAM_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# Model names.
#   - 'sarvam' already knows its models (text=glm5.2, vision=gemma4) -> leave blank.
#   - every other provider REQUIRES both, since hosted names change often and a
#     stale default would only fail confusingly. Check the provider's docs for the
#     current name. Examples (verify before using):
#       openai     text=gpt-4.1-mini       vision=gpt-4.1-mini
#       anthropic  text=claude-haiku-4-5   vision=claude-haiku-4-5
#       google     text=gemini-2.5-flash   vision=gemini-2.5-flash
#       groq       text=openai/gpt-oss-120b  vision=meta-llama/llama-4-scout-17b-16e-instruct
# TEXT_MODEL=
# VISION_MODEL=

# For anthropic or google you also need the extra package:
#   pip install -e ".[anthropic]"      or      pip install -e ".[google]"

# =============================================================================
# B. DIFFERENT PROVIDER PER ROLE  (optional)
# =============================================================================
#
# Each role - text / vision / worker - can override the provider and model set by
# MODEL_PROFILE. Set the API key for EVERY provider you reference.
#
# Example: text on OpenAI, vision on Google, worker follows text.
#
#   MODEL_PROFILE=openai
#   OPENAI_API_KEY=sk-...
#   TEXT_MODEL=gpt-4.1-mini
#
#   VISION_PROVIDER=google
#   VISION_MODEL=gemini-2.5-flash
#   GOOGLE_API_KEY=...
#
# The overrides (uncomment the ones you need):
# TEXT_PROVIDER=
# TEXT_MODEL=
# VISION_PROVIDER=
# VISION_MODEL=

# Background worker model - the reflection pass and the nutrition fallback.
# Defaults to the text model if left unset.
# WORKER_PROVIDER=
# WORKER_MODEL=

# =============================================================================
# LangSmith tracing  (optional bonus - free at smith.langchain.com)
# =============================================================================
#
# 1. Sign in at smith.langchain.com
# 2. Settings (bottom-left) -> API Keys -> Create API Key  (starts with lsv2_pt_)
# 3. Put the key below and set LANGSMITH_TRACING=true
# 4. Run the agent; traces appear under Tracing -> the project name below
# 5. Open a trace, click "Share" (top-right) to make it public, copy the link
#    into the README
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=calorai-logging-agent

# =============================================================================
# Runtime  (sensible defaults - override only if needed)
# =============================================================================
# CALORAI_DATA_DIR=./data
# CALORAI_DB_PATH=./data/calorai.db
AGENT_MAX_LOOPS=4
REQUEST_TIMEOUT_SECONDS=60
